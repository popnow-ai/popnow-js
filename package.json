{
  "name": "popnow",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the PopNow API: AI video, image, music and speech generation with Kling, Seedance, Wan, Nano Banana, Flux and more.",
  "license": "MIT",
  "author": "PopNow (https://popnow.ai)",
  "homepage": "https://github.com/popnow-ai/popnow-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popnow-ai/popnow-js.git"
  },
  "bugs": {
    "url": "https://github.com/popnow-ai/popnow-js/issues"
  },
  "keywords": [
    "popnow",
    "ai",
    "ai-video",
    "text-to-video",
    "image-to-video",
    "text-to-image",
    "ai-image-generator",
    "ai-music",
    "text-to-speech",
    "kling",
    "seedance",
    "wan",
    "nano-banana",
    "flux",
    "sdk",
    "api-client",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke.cjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
